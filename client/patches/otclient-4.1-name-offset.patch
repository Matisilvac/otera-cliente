diff --git a/src/client/thingtypemanager.h b/src/client/thingtypemanager.h
index 8fcc9ad..7cf3b71 100644
--- a/src/client/thingtypemanager.h
+++ b/src/client/thingtypemanager.h
@@ -86,6 +86,24 @@ public:
     bool isDatLoaded() { return m_datLoaded; }
     bool isValidDatId(const uint16_t id, const ThingCategory category) const { return category < ThingLastCategory && id >= 1 && id < m_thingTypes[category].size(); }
 
+    // Otera: where the name and the bars of a creature go, by outfit, in map pixels from
+    // their usual place. An outfit is drawn with its bottom right corner on the tile of
+    // the creature, so the body of a big one can be far from it.
+    void setCreatureInformationOffset(const uint16_t outfit, const Point& offset)
+    {
+        if (offset.isNull())
+            m_creatureInformationOffsets.erase(outfit);
+        else
+            m_creatureInformationOffsets[outfit] = offset;
+    }
+    Point getCreatureInformationOffset(const uint16_t outfit) const
+    {
+        if (m_creatureInformationOffsets.empty())
+            return {};
+        const auto it = m_creatureInformationOffsets.find(outfit);
+        return it != m_creatureInformationOffsets.end() ? it->second : Point();
+    }
+
